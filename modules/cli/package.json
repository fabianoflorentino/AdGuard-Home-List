{
  "name": "adguard-home-list-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Generate the AdGuard Home allowlist and blocklist",
  "license": "GPL-3.0",
  "author": "fabianoflorentino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabianoflorentino/AdGuard-Home-List.git"
  },
  "bugs": {
    "url": "https://github.com/fabianoflorentino/AdGuard-Home-List/issues"
  },
  "homepage": "https://github.com/fabianoflorentino/AdGuard-Home-List#readme",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test dist",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
